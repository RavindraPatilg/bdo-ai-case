# Copy this file to .env and fill in your key. Never commit .env.
LLM_PROVIDER=openai
OPENAI_API_KEY=gsk_...paste your Groq key here...
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
APP_ACCESS_TOKEN=
RATE_LIMIT_PER_HOUR=10
ENVIRONMENT=development
DATABASE_PATH=analyses.db

# --- Web-search fallback (companies with no homepage registered in Brreg) ---
# Leave SEARCH_PROVIDER=none to keep registry facts only. Set it to serper to enable
# the web-search fallback for companies without a registered homepage.
# serper:  https://serper.dev - 2500 free searches, no credit card needed
SEARCH_PROVIDER=none          # none | serper
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=3
